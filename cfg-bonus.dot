digraph bonus {
  graph [rankdir=TB, fontname="DejaVu Sans", label="CFG: DataFlowTargets.bonus(attendance, threshold) - node = file line, edge = JUnit test methods that traverse it", labelloc=t, fontsize=16, nodesep=0.5, ranksep=0.45, dpi=130];
  node [shape=box, style="rounded,filled", fillcolor="#f4f6fb", fontname="DejaVu Sans Mono", fontsize=12];
  edge [fontname="DejaVu Sans Mono", fontsize=9, color="#444444"];
  n31 [label="31: bonus(attendance, threshold)\ndef attendance, threshold", fillcolor="#e3f2e1"];
  n32 [label="32: attendance == null || threshold < 0\np-use attendance, threshold", shape=diamond, fillcolor="#fff4d6"];
  n33 [label="33: throw IllegalArgumentException", fillcolor="#fde2e2"];
  n35 [label="35: present = 0   (def present)\n36: streak = 0    (def streak)\n37: best = 0      (def best)"];
  n38c [label="38: attendance has next element?\np-use attendance", shape=diamond, fillcolor="#fff4d6"];
  n38d [label="38: a = next element\ndef a"];
  n39 [label="39: a > 0\np-use a", shape=diamond, fillcolor="#fff4d6"];
  n40 [label="40: present = present + 1  (c-use, def present)\n41: streak = streak + 1    (c-use, def streak)"];
  n42 [label="42: streak > best\np-use streak, best", shape=diamond, fillcolor="#fff4d6"];
  n43 [label="43: best = streak\nc-use streak, def best"];
  n46 [label="46: streak = 0\ndef streak  (KILLS streak defs 36, 41)", fillcolor="#fde2e2"];
  n49 [label="49: score = 0\ndef score"];
  n50 [label="50: present >= threshold\np-use present, threshold", shape=diamond, fillcolor="#fff4d6"];
  n51 [label="51: score = 5\ndef score (kills 49)"];
  n53 [label="53: best >= 5\np-use best", shape=diamond, fillcolor="#fff4d6"];
  n54 [label="54: score = score + 3\nc-use score, def score"];
  n56 [label="56: return score\nc-use score", fillcolor="#e3f2e1"];

  n31 -> n32 [label=" all tests"];
  n32 -> n33 [label=" T: du1_nullAttendance_throws\n du2_negativeThreshold_throws"];
  n32 -> n35 [label=" F: ad1_streakOfFiveThenBreak_exactThreshold\n ad2_allAbsent_belowThreshold"];
  n35 -> n38c [label=" ad1_streakOfFiveThenBreak_exactThreshold\n du3_emptyArray_thresholdZero"];
  n38c -> n38d [label=" T: ad1_streakOfFiveThenBreak_exactThreshold\n du4_presentAbsentPresent_belowThreshold"];
  n38c -> n49 [label=" F: du3_emptyArray_thresholdZero\n ad1_streakOfFiveThenBreak_exactThreshold"];
  n38d -> n39 [label=" ad1_streakOfFiveThenBreak_exactThreshold\n ad2_allAbsent_belowThreshold"];
  n39 -> n40 [label=" T: ad1_streakOfFiveThenBreak_exactThreshold\n du5_streakOfFive_belowThreshold"];
  n39 -> n46 [label=" F: ad2_allAbsent_belowThreshold\n du4_presentAbsentPresent_belowThreshold"];
  n40 -> n42 [label=" ad1_streakOfFiveThenBreak_exactThreshold\n du4_presentAbsentPresent_belowThreshold"];
  n42 -> n43 [label=" T: ad1_streakOfFiveThenBreak_exactThreshold\n du6_streakLongerThanFive_thresholdZero"];
  n42 -> n38c [label=" F: du4_presentAbsentPresent_belowThreshold\n du7_longRunBrokenInMiddle_noStreakBonus", constraint=false];
  n43 -> n38c [label=" ad1_streakOfFiveThenBreak_exactThreshold\n k1_bestUpdatedAfterBreak_presentDiffersFromStreak", constraint=false];
  n46 -> n38c [label=" ad1_streakOfFiveThenBreak_exactThreshold\n ad2_allAbsent_belowThreshold", constraint=false];
  n49 -> n50 [label=" ad1_streakOfFiveThenBreak_exactThreshold\n du3_emptyArray_thresholdZero"];
  n50 -> n51 [label=" T: ad1_streakOfFiveThenBreak_exactThreshold\n du3_emptyArray_thresholdZero"];
  n50 -> n53 [label=" F: ad2_allAbsent_belowThreshold\n du5_streakOfFive_belowThreshold"];
  n51 -> n53 [label=" ad1_streakOfFiveThenBreak_exactThreshold\n du3_emptyArray_thresholdZero"];
  n53 -> n54 [label=" T: ad1_streakOfFiveThenBreak_exactThreshold\n du5_streakOfFive_belowThreshold"];
  n53 -> n56 [label=" F: ad2_allAbsent_belowThreshold\n du4_presentAbsentPresent_belowThreshold"];
  n54 -> n56 [label=" ad1_streakOfFiveThenBreak_exactThreshold\n du5_streakOfFive_belowThreshold"];
}
